---
// Una pieza de contenido dibujada con formas: el vocabulario visual que se repite en el calendario, el
// celular, el muro y el perfil. Son ilustraciones, no trabajos reales de clientes.
export type TipoPieza = 'post' | 'carrusel' | 'video' | 'historia' | 'pagada';

interface Props {
  tipo?: TipoPieza;
  variante?: number;
  class?: string;
}

const { tipo = 'post', variante = 0, class: extra } = Astro.props;
const v = variante % 3;
const conFormas = tipo === 'post' || tipo === 'pagada' || tipo === 'carrusel';
---

<span class:list={['pieza', `pieza-${tipo}`, conFormas && `v${v}`, extra]} aria-hidden="true">
  {conFormas && v === 0 && <span class="forma circulo" />}
  {
    conFormas && v === 1 && (
      <>
        <span class="forma barra b1" />
        <span class="forma barra b2" />
      </>
    )
  }
  {conFormas && v === 2 && <span class="forma cuarto" />}
  {tipo === 'carrusel' && <span class="puntos"><i /><i /><i /></span>}
  {tipo === 'video' && <span class="forma play" />}
  {tipo === 'historia' && <span class="forma nucleo" />}
  {tipo === 'pagada' && <span class="sello" />}
</span>

<style>
  .pieza {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radio-chico);
    overflow: hidden;
  }

  .v0 {
    background: var(--naranja);
  }

  .v1 {
    background: var(--blanco);
    box-shadow: inset 0 0 0 1px var(--linea);
  }

  .v2 {
    background: var(--puerto-claro);
  }

  /* Carrusel: una segunda hoja asomando detrás y los puntos de paginación. */
  .pieza-carrusel {
    overflow: visible;
    box-shadow: 4px -4px 0 0 rgb(255 255 255 / 0.35);
  }

  .puntos {
    position: absolute;
    left: 50%;
    bottom: 8%;
    translate: -50% 0;
    display: flex;
    gap: 3px;
  }

  .puntos i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--tinta);
    opacity: 0.45;
  }

  .puntos i:first-child {
    opacity: 1;
  }

  .pieza-video {
    background: var(--tinta);
    box-shadow: inset 0 0 0 2px var(--puerto-claro);
  }

  .play {
    left: 38%;
    top: 30%;
    width: 30%;
    height: 40%;
    background: var(--naranja);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .pieza-historia {
    background: transparent;
    border-radius: 50%;
    box-shadow: inset 0 0 0 3px var(--naranja);
  }

  .nucleo {
    inset: 22%;
    border-radius: 50%;
    background: var(--puerto-claro);
  }

  /* Pagada: marco naranja y sello en la esquina, "esta se promociona". */
  .pieza-pagada {
    box-shadow: inset 0 0 0 3px var(--naranja);
  }

  .pieza-pagada.v0 {
    box-shadow: inset 0 0 0 3px var(--blanco);
  }

  .sello {
    position: absolute;
    top: 8%;
    right: 8%;
    width: 26%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--blanco);
    box-shadow: 0 0 0 2px var(--naranja);
  }

  .forma {
    position: absolute;
  }

  .circulo {
    inset: 28% 18% auto auto;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--tinta);
  }

  .barra {
    left: 16%;
    height: 12%;
    border-radius: 99px;
    background: var(--tinta);
  }

  .b1 {
    top: 30%;
    width: 64%;
  }

  .b2 {
    top: 52%;
    width: 40%;
    background: var(--naranja);
  }

  .cuarto {
    right: 0;
    bottom: 0;
    width: 60%;
    aspect-ratio: 1;
    border-top-left-radius: 100%;
    background: var(--naranja);
  }
</style>
