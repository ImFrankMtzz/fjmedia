---
// Cuatro pasos reales del servicio de redes. El celular se queda fijo mientras bajan los pasos y
// cambia de pantalla según el paso visible (scripts/motion.ts). Sin JS se ve la primera pantalla.
const pasos = [
  {
    titulo: 'Planeamos el mes',
    texto:
      'Antes de que empiece el mes definimos qué se publica y cuándo: fechas importantes, promociones y los temas de tu negocio.',
  },
  {
    titulo: 'Diseñamos cada pieza',
    texto:
      'Cada pieza lleva la imagen de tu marca, para que tu perfil se vea igual de cuidado todo el mes.',
  },
  {
    titulo: 'Publicamos por ti',
    texto: 'Tus publicaciones salen en Facebook e Instagram en los días planeados. Tú te enfocas en atender a tus clientes.',
  },
  {
    titulo: 'Promocionamos en Facebook',
    texto: 'Cuando quieres llegar a más gente, promocionamos tus publicaciones en Facebook para personas de tu zona.',
  },
];

const plan = [
  { dia: 'Lunes', tipo: 'Publicación', clase: 'post' },
  { dia: 'Martes', tipo: 'Historia', clase: 'historia' },
  { dia: 'Miércoles', tipo: 'Video', clase: 'video' },
  { dia: 'Jueves', tipo: 'Carrusel', clase: 'post' },
  { dia: 'Viernes', tipo: 'Pagada en Facebook', clase: 'pagada' },
  { dia: 'Sábado', tipo: 'Historia', clase: 'historia' },
];
---

<section id="como-creamos" class="creamos" aria-labelledby="creamos-titulo">
  <div class="envoltura">
    <h2 id="creamos-titulo" class="cinetico">Cómo creamos tu contenido</h2>
  </div>

  <div class="envoltura creamos-rejilla">
    <div class="telefono-zona">
      <div class="telefono" data-telefono data-paso="1" aria-hidden="true">
        <div class="pantalla" data-pantalla="1">
          <p class="p-titulo">Plan del mes</p>
          <ul class="plan">
            {
              plan.map((p) => (
                <li class="plan-fila">
                  <span class:list={['plan-punto', p.clase]} />
                  <span class="plan-dia">{p.dia}</span>
                  <span>{p.tipo}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="pantalla" data-pantalla="2">
          <p class="p-titulo">Diseño</p>
          <div class="lienzo">
            <span class="capa capa-fondo"></span>
            <span class="capa capa-circulo"></span>
            <span class="capa capa-barra c1"></span>
            <span class="capa capa-barra c2"></span>
            <span class="capa capa-logo">FJ</span>
          </div>
        </div>

        <div class="pantalla" data-pantalla="3">
          <div class="perfil">
            <span class="avatar"></span>
            <span class="perfil-nombre">Tu negocio</span>
          </div>
          <div class="post">
            <div class="lienzo lienzo-chico">
              <span class="capa capa-fondo"></span>
              <span class="capa capa-circulo"></span>
              <span class="capa capa-barra c1"></span>
              <span class="capa capa-barra c2"></span>
            </div>
            <div class="post-acciones">
              <svg class="corazon" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.4 2.3 4.5 6 4.5c2.2 0 3.6 1.2 4.3 2.4h.1c.7-1.2 2.1-2.4 4.3-2.4 3.7 0 5.6 3.9 4 7.2C19.5 16.4 12 21 12 21z"/></svg>
              <span class="texto-falso"></span>
            </div>
          </div>
        </div>

        <div class="pantalla" data-pantalla="4">
          <div class="alcance">
            <span class="onda"></span>
            <span class="onda"></span>
            <span class="onda"></span>
            <div class="post post-anuncio">
              <span class="etiqueta-anuncio">Publicación pagada</span>
              <div class="lienzo lienzo-chico">
                <span class="capa capa-fondo"></span>
                <span class="capa capa-circulo"></span>
                <span class="capa capa-barra c1"></span>
                <span class="capa capa-barra c2"></span>
              </div>
            </div>
          </div>
          <div class="pastillas">
            <span class="pastilla">Personas de tu zona</span>
            <span class="pastilla">Posibles clientes</span>
          </div>
        </div>
      </div>
    </div>

    <ol class="pasos">
      {
        pasos.map((p, i) => (
          <li class="paso" data-paso={i + 1}>
            <span class="paso-num" aria-hidden="true">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .creamos {
    padding: clamp(64px, 9vw, 120px) 0 clamp(32px, 6vw, 80px);
  }

  .creamos-rejilla {
    display: grid;
    margin-top: clamp(24px, 4vw, 48px);
  }

  @media (min-width: 900px) {
    .creamos-rejilla {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 48px;
    }

    .telefono-zona {
      order: 2;
    }
  }

  /* En celular el teléfono se queda pegado arriba sobre una banda del color del fondo y los pasos
     pasan por debajo; en escritorio se queda centrado a la derecha. */
  .telefono-zona {
    position: sticky;
    top: var(--cabecera);
    z-index: 2;
    background: var(--papel);
    padding: 12px 0 16px;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .telefono-zona {
      top: calc(var(--cabecera) + (100svh - var(--cabecera) - 560px) / 2);
      align-self: start;
      padding: 0;
      background: none;
    }
  }

  .telefono {
    position: relative;
    width: 170px;
    height: 300px;
    border-radius: 28px;
    background: var(--tinta);
    padding: 10px;
    box-shadow: 0 30px 60px -30px rgb(13 26 42 / 0.55);
  }

  @media (min-width: 900px) {
    .telefono {
      width: 290px;
      height: 560px;
      border-radius: 42px;
      padding: 14px;
    }
  }

  .pantalla {
    position: absolute;
    inset: 10px;
    border-radius: 20px;
    background: var(--blanco);
    padding: 14px 12px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s;
  }

  @media (min-width: 900px) {
    .pantalla {
      inset: 14px;
      border-radius: 30px;
      padding: 28px 22px;
    }
  }

  .telefono[data-paso='1'] [data-pantalla='1'],
  .telefono[data-paso='2'] [data-pantalla='2'],
  .telefono[data-paso='3'] [data-pantalla='3'],
  .telefono[data-paso='4'] [data-pantalla='4'] {
    opacity: 1;
    visibility: visible;
  }

  .p-titulo {
    font-family: var(--display);
    font-weight: 760;
    font-stretch: 110%;
    font-size: clamp(0.8rem, 1.4vw, 1.2rem);
    margin-bottom: 10px;
  }

  .plan {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: clamp(0.6rem, 1.1vw, 0.9rem);
  }

  .plan-fila {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 8px;
    background: var(--papel);
  }

  .plan-dia {
    font-weight: 700;
  }

  .plan-punto {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--naranja);
  }

  .plan-punto.historia {
    border-radius: 50%;
    background: none;
    box-shadow: inset 0 0 0 2px var(--naranja);
  }

  .plan-punto.video {
    background: var(--tinta);
  }

  .plan-punto.pagada {
    background: var(--blanco);
    box-shadow: inset 0 0 0 3px var(--naranja);
  }

  .lienzo {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
  }

  .capa {
    position: absolute;
  }

  .capa-fondo {
    inset: 0;
    background: var(--naranja);
  }

  .capa-circulo {
    width: 44%;
    aspect-ratio: 1;
    right: 12%;
    top: 14%;
    border-radius: 50%;
    background: var(--tinta);
  }

  .capa-barra {
    left: 10%;
    height: 8%;
    border-radius: 99px;
    background: var(--tinta);
  }

  .c1 {
    bottom: 26%;
    width: 60%;
  }

  .c2 {
    bottom: 12%;
    width: 36%;
    background: var(--blanco);
  }

  .capa-logo {
    left: 10%;
    top: 10%;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(0.7rem, 1.4vw, 1.1rem);
    color: var(--tinta);
  }

  .perfil {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: clamp(0.6rem, 1.1vw, 0.9rem);
    font-weight: 700;
  }

  .avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--tinta);
    box-shadow: 0 0 0 2px var(--blanco), 0 0 0 4px var(--naranja);
  }

  .post-acciones {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .corazon {
    width: 20px;
    fill: var(--naranja);
  }

  .texto-falso {
    flex: 1;
    height: 8px;
    border-radius: 99px;
    background: var(--linea);
  }

  .alcance {
    position: relative;
    display: grid;
    place-items: center;
    padding: 18% 10%;
  }

  .onda {
    position: absolute;
    width: 120%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--naranja);
    opacity: 0.25;
  }

  .onda:nth-child(2) {
    width: 95%;
    opacity: 0.4;
  }

  .onda:nth-child(3) {
    width: 70%;
    opacity: 0.6;
  }

  .post-anuncio {
    position: relative;
    width: 78%;
    background: var(--blanco);
    padding: 6px;
    border-radius: 12px;
    box-shadow: 0 10px 30px -12px rgb(13 26 42 / 0.4);
  }

  .etiqueta-anuncio {
    display: block;
    font-size: clamp(0.55rem, 1vw, 0.75rem);
    font-weight: 700;
    color: var(--gris);
    margin-bottom: 4px;
  }

  .pastillas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .pastilla {
    font-size: clamp(0.55rem, 1vw, 0.8rem);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--tinta);
    color: var(--blanco);
  }

  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .paso {
    min-height: 62svh;
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 32px 0;
    /* Paso inactivo: gris que sigue cumpliendo AA (5:1 sobre papel), en vez de bajar la opacidad. */
    --c-titulo: #5a6a7e;
    --c-texto: #5a6a7e;
    --c-num: #5a6a7e;
  }

  .paso.activo,
  :global(html:not(.motion)) .paso {
    --c-titulo: var(--tinta);
    --c-texto: var(--gris);
    --c-num: var(--naranja-texto);
  }

  .paso h3,
  .paso p,
  .paso-num {
    transition: color 0.4s ease;
  }

  @media (min-width: 900px) {
    .paso {
      min-height: 80svh;
    }
  }

  .paso-num {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 120%;
    font-size: var(--t-3);
    color: var(--c-num);
  }

  .paso h3 {
    font-size: var(--t-3);
    font-weight: 760;
    color: var(--c-titulo);
  }

  .paso p {
    color: var(--c-texto);
    font-size: var(--t-1);
    max-width: 40ch;
  }
</style>
