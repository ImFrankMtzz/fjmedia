---
import Pendiente from './Pendiente.astro';
import { clientes, url } from '../data/fj';

---

<section id="clientes" class="clientes" aria-labelledby="clientes-titulo">
  <div class="envoltura">
    <h2 id="clientes-titulo" class="cinetico">Con quién trabajamos</h2>

    <ul class="lista-clientes">
      {
        clientes.map((c) => (
          <li class="cliente">
            <div class="cliente-logo">
              {c.logo ? (
                <img src={url(c.logo)} alt={`Logotipo de ${c.nombreLargo ?? c.nombre}`} loading="lazy" />
              ) : (
                <span class="logo-texto">{c.nombre}</span>
              )}
            </div>
            <div class="cliente-info">
              <h3>{c.nombre}</h3>
              <ul class="etiquetas" aria-label="Lo que hacemos">
                {c.servicios.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              {!c.logo && <Pendiente texto={`logotipo de ${c.nombre}.`} />}
            </div>
          </li>
        ))
      }
    </ul>

    <p class="clientes-mas">
      <a href={url('paginas-web/#caso')}>Mira cómo quedó la página de Clínica Santa Clara</a>
    </p>
  </div>
</section>

<style>
  .clientes {
    padding: clamp(64px, 9vw, 120px) 0;
    background: var(--blanco);
  }

  .lista-clientes {
    list-style: none;
    margin: clamp(24px, 4vw, 48px) 0 0;
    padding: 0;
  }

  .cliente {
    display: grid;
    gap: 16px 32px;
    align-items: center;
    padding: 24px 0;
    border-top: 1px solid var(--linea);
  }

  @media (min-width: 700px) {
    .cliente {
      grid-template-columns: 220px minmax(0, 1fr);
    }
  }

  .cliente-logo {
    height: 96px;
    display: flex;
    align-items: center;
  }

  .cliente-logo img {
    max-height: 88px;
    max-width: 200px;
    width: auto;
    object-fit: contain;
  }

  .logo-texto {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-2);
    font-stretch: 90%;
    padding: 10px 14px;
    border: 2px dashed var(--linea);
    border-radius: var(--radio-chico);
  }

  .cliente-info {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  .cliente-info h3 {
    font-size: var(--t-3);
    font-weight: 760;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .etiquetas li {
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--papel);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .clientes-mas {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--linea);
  }

  .clientes-mas a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--naranja-texto);
  }
</style>
