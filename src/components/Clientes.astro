---
import Pendiente from './Pendiente.astro';
import { clientes, url } from '../data/fj';

// Datos del caso Santa Clara: solo hechos verificables del sitio publicado (ver su CLAUDE.md y la propuesta).
const hechosSantaClara = [
  'Botón para llamar a urgencias en cada página',
  'WhatsApp con el mensaje listo para pedir cita',
  'Mapa y cómo llegar, con la dirección confirmada por la clínica',
  'Hecho para leerse bien en celular y cumplir accesibilidad WCAG AA',
];
---

<section id="clientes" class="clientes" aria-labelledby="clientes-titulo">
  <div class="envoltura">
    <h2 id="clientes-titulo" class="cinetico">Con quién trabajamos</h2>

    <ul class="lista-clientes">
      {
        clientes.map((c) => (
          <li class="cliente">
            <div class="cliente-logo">
              {c.logo ? (
                <img src={url(c.logo)} alt={`Logotipo de ${c.nombreLargo ?? c.nombre}`} loading="lazy" />
              ) : (
                <span class="logo-texto">{c.nombre}</span>
              )}
            </div>
            <div class="cliente-info">
              <h3>{c.nombre}</h3>
              <ul class="etiquetas" aria-label="Lo que hacemos">
                {c.servicios.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              {!c.logo && <Pendiente texto={`logotipo de ${c.nombre}.`} />}
            </div>
          </li>
        ))
      }
    </ul>

    <article class="caso" aria-labelledby="caso-titulo">
      <div class="caso-texto">
        <h3 id="caso-titulo">Clínica Santa Clara: su página web</h3>
        <p>
          La clínica atiende las 24 horas y necesitaba un lugar propio en internet, con teléfonos, horarios y dirección
          correctos. Le hicimos su sitio con la información que la propia clínica confirmó.
        </p>
        <ul class="hechos">
          {hechosSantaClara.map((h) => <li>{h}</li>)}
        </ul>
        <a class="boton boton-secundario" href="https://clinicasantaclara.mx" rel="noopener" target="_blank">
          Visitar clinicasantaclara.mx<span class="visualmente-oculto"> (se abre en otra pestaña)</span>
        </a>
      </div>
      <div class="caso-capturas">
        <img
          class="captura-escritorio"
          src={url('clientes/santa-clara-escritorio.webp')}
          alt="Página de inicio de clinicasantaclara.mx en computadora"
          width="1360"
          height="850"
          loading="lazy"
        />
        <img
          class="captura-celular"
          src={url('clientes/santa-clara-celular.webp')}
          alt="Página de inicio de clinicasantaclara.mx en celular"
          width="390"
          height="844"
          loading="lazy"
        />
      </div>
    </article>
  </div>
</section>

<style>
  .clientes {
    padding: clamp(64px, 9vw, 120px) 0;
    background: var(--blanco);
  }

  .lista-clientes {
    list-style: none;
    margin: clamp(24px, 4vw, 48px) 0 0;
    padding: 0;
  }

  .cliente {
    display: grid;
    gap: 16px 32px;
    align-items: center;
    padding: 24px 0;
    border-top: 1px solid var(--linea);
  }

  @media (min-width: 700px) {
    .cliente {
      grid-template-columns: 220px minmax(0, 1fr);
    }
  }

  .cliente-logo {
    height: 96px;
    display: flex;
    align-items: center;
  }

  .cliente-logo img {
    max-height: 88px;
    max-width: 200px;
    width: auto;
    object-fit: contain;
  }

  .logo-texto {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--t-2);
    font-stretch: 90%;
    padding: 10px 14px;
    border: 2px dashed var(--linea);
    border-radius: var(--radio-chico);
  }

  .cliente-info {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  .cliente-info h3 {
    font-size: var(--t-3);
    font-weight: 760;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .etiquetas li {
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--papel);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .caso {
    display: grid;
    gap: 32px;
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(22px, 4vw, 48px);
    border-radius: var(--radio);
    background: var(--papel);
    align-items: center;
  }

  @media (min-width: 960px) {
    .caso {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .caso-texto {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .caso h3 {
    font-size: var(--t-3);
    font-weight: 760;
  }

  .caso p {
    color: var(--gris);
  }

  .hechos {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: 6px;
  }

  .hechos li::marker {
    color: var(--naranja-texto);
  }

  .caso-capturas {
    position: relative;
    padding-right: 14%;
    padding-bottom: 8%;
  }

  .captura-escritorio {
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 24px 50px -28px rgb(13 26 42 / 0.6);
  }

  .captura-celular {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26%;
    height: auto;
    border-radius: 14px;
    border: 4px solid var(--tinta);
    box-shadow: 0 24px 50px -24px rgb(13 26 42 / 0.7);
  }
</style>
